---
import Section from "@/components/Section.astro";
import { education } from "@cv-es";
---

<Section
  title="Educación"
  num="01"
>
  {
    education.map(({ institution, area, startDate, endDate }) => {
      const startYear = new Date(startDate).getFullYear();
      const endYear = endDate ? new Date(endDate).getFullYear() : "Presente";

      return (
        <div class="edu-item">
          <div class="edu-header">
            <span class="edu-school">{institution}</span>
            <span class="edu-date">
              {startYear} - {endYear}
            </span>
          </div>

          <p class="edu-degree">{area}</p>
        </div>
      );
    })
  }
</Section>

<style>
  .edu-item {
    padding: 1rem 0;
  }

  .edu-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.2rem;
  }

  .edu-school {
    font-weight: 600;
    font-size: 1.02rem;
  }

  .edu-date {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .edu-degree {
    color: var(--text-secondary);
    font-size: 0.92rem;
  }

  @media print {
    .edu-school {
      font-size: 10.5pt;
      font-weight: 700;
    }
    .edu-date {
      font-family: "Times New Roman", serif;
      font-size: 10pt;
      color: #333 !important;
    }

    .edu-degree {
      font-size: 10pt;
      color: #222 !important;
    }
  }

  @media (max-width: 37.5rem) {
    .edu-header {
      flex-direction: column;
      gap: 0.15rem;
    }
  }
</style>
