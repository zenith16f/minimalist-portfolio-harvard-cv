---
import Section from "@/components/Section.astro";
import { interests } from "@cv-es";

const ICONS: Record<string, string> = {
  gamepad: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><line x1="6" y1="11" x2="10" y2="11"/><line x1="8" y1="9" x2="8" y2="13"/><line x1="15" y1="12" x2="15.01" y2="12"/><line x1="18" y1="10" x2="18.01" y2="10"/><path d="M17.32 5H6.68a4 4 0 00-3.978 3.59c-.006.052-.01.101-.017.152C2.604 9.416 2 14.456 2 16a3 3 0 003 3c1 0 1.5-.5 2-1l1.414-1.414A2 2 0 019.828 16h4.344a2 2 0 011.414.586L17 18c.5.5 1 1 2 1a3 3 0 003-3c0-1.545-.604-6.584-.685-7.258-.007-.05-.011-.1-.017-.151A4 4 0 0017.32 5z"/></svg>`,
  globe: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>`,
  palette: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="13.5" cy="6.5" r="0.01"/><circle cx="17.5" cy="10.5" r="0.01"/><circle cx="8.5" cy="7.5" r="0.01"/><circle cx="6.5" cy="12" r="0.01"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 011.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/></svg>`,
};
---

<Section
  title="Intereses"
  num="06"
>
  <div class="interests-grid">
    {
      interests.map(({ name, icon, description }) => (
        <div class="interest-card">
          <div
            class="interest-icon"
            set:html={ICONS[icon] || ICONS.globe}
          />
          <div class="interest-content">
            <h3>{name}</h3>
            {description && <p>{description}</p>}
          </div>
        </div>
      ))
    }
  </div>
</Section>

<style>
  .interests-grid {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .interest-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-radius: 10px;
    border: 1px solid var(--border-subtle);
    background: var(--bg-card);
    transition: all 0.25s ease;
  }

  .interest-card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-sm);
    transform: translateX(4px);
  }

  .interest-icon {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    padding: 7px;
    border-radius: 8px;
    background: var(--accent-soft);
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .interest-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .interest-content h3 {
    font-family: var(--font-body);
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.15rem;
  }

  .interest-content p {
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.45;
  }

  /* ── Print ── */
  @media print {
    .interests-grid {
      display: block;
      columns: 2;
      column-gap: 1.5cm;
    }

    .interest-card {
      break-inside: avoid;
      border: none;
      background: none;
      padding: 0.1cm 0;
      margin-bottom: 0.15cm;
      gap: 0.3cm;
    }

    .interest-icon {
      display: none;
    }

    .interest-content h3 {
      font-family: "Times New Roman", serif;
      font-size: 10.5pt;
      font-weight: 700;
    }

    .interest-content p {
      font-family: "Times New Roman", serif;
      font-size: 9.5pt;
      color: #333 !important;
    }
  }

  /* ── Responsive ── */
  @media (max-width: 600px) {
    .interest-card {
      padding: 0.85rem 1rem;
    }
  }
</style>
