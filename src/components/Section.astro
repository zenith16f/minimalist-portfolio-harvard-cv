---
interface props {
  title?: string;
  num?: string;
}

const { title, num } = Astro.props;
---

<section>
  {
    title && (
      <h2 class="section-title">
        {num && <span class="num">{num}</span>}
        {title}
      </h2>
    )
  }
  <slot />
</section>

<style>
  section {
    margin-bottom: 4rem;
    animation: fadeUp 0.6s ease both;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 400;
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1.5px solid var(--border);
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .num {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--accent);
    font-weight: 500;
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(1.5rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
